{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "vite build --outDir vercel-out/superadmin",
  "outputDirectory": "vercel-out",
  "redirects": [
    { "source": "/", "destination": "/superadmin/", "permanent": false },
    { "source": "/superadmin", "destination": "/superadmin/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://presentme.in/api/:path*" },
    { "source": "/superadmin/:path*", "destination": "/superadmin/index.html" }
  ]
}
